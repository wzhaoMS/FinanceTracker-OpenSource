{
  "name": "@finance-tracker/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "build:release": "tsx scripts/buildRelease.ts",
    "verify:release": "tsx scripts/verifyRelease.ts",
    "preview": "vite preview --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node ../../scripts/rm.mjs dist .turbo",
    "pretest:unit": "npm run build --workspace @finance-tracker/shared",
    "test:unit": "node ../../scripts/run-tsx-tests.mjs src .test.ts --import=../../scripts/loopback-only.mjs",
    "test": "playwright test -c playwright.harness.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --ui-host=127.0.0.1"
  },
  "dependencies": {
    "@finance-tracker/shared": "*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "css-tree": "3.1.0",
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "parse5": "7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
