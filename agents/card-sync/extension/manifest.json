{
  "manifest_version": 3,
  "name": "Holdr Card Sync (experimental)",
  "version": "0.1.0",
  "description": "Saves your American Express statement exports to the Holdr receiver on this computer, for review and import in Holdr.",
  "minimum_chrome_version": "111",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Holdr Card Sync" },
  "content_scripts": [
    {
      "matches": ["https://global.americanexpress.com/*"],
      "js": ["amex-page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://global.americanexpress.com/*"],
      "js": ["amex-sync.js", "amex-panel.js"],
      "run_at": "document_idle"
    }
  ]
}
