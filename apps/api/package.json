{
  "name": "@finance-tracker/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copyRuntime.mjs",
    "build:native": "tsx scripts/buildNative.ts",
    "verify:native": "tsx scripts/verifyNative.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "holdr-user": "tsx src/cli/holdrUserMain.ts",
    "holdr-ingress": "tsx src/cli/ingressMain.ts",
    "holdr-recovery": "tsx src/cli/holdrRecoveryMain.ts",
    "holdr-lifecycle": "tsx src/cli/holdrLifecycleMain.ts",
    "holdr-backup": "tsx src/cli/holdrBackupMain.ts",
    "holdr-spending-rules": "tsx src/cli/spendingRulesMain.ts",
    "holdr-card-openings": "tsx src/cli/cardOpeningsMain.ts",
    "holdr-checking": "tsx src/cli/checkingMain.ts",
    "holdr-checking-convert": "tsx src/cli/checkingConvertMain.ts",
    "holdr-card-statement-convert": "tsx src/cli/cardStatementConvertMain.ts",
    "holdr-retail-convert": "tsx src/cli/retailConvertMain.ts",
    "holdr-retail-convert-owner-only": "tsx src/cli/retailConvertOwnerOnlyMain.ts",
    "holdr-metals-convert": "tsx src/cli/metalsConvertMain.ts",
    "holdr-payment-reconciliation": "tsx src/cli/paymentReconciliationMain.ts",
    "holdr-balance-chain": "tsx src/cli/balanceChainMain.ts",
    "holdr-cash": "tsx src/cli/cashPlanMain.ts",
    "holdr-card-import-proof": "tsx src/cli/cardImportProofMain.ts",
    "holdr-card-kinds": "tsx src/cli/cardKindCorrectionsMain.ts",
    "holdr-metals": "tsx src/cli/metalsMain.ts",
    "holdr-retail": "tsx src/cli/retailMain.ts",
    "test": "vitest run",
    "test:ingress": "vitest run -c vitest.ingress.config.ts",
    "test:stack": "vitest run -c vitest.stack.config.ts",
    "test:watch": "vitest",
    "e2e:seed": "tsx src/e2e/seedCli.ts",
    "clean": "node ../../scripts/rm.mjs dist .turbo"
  },
  "dependencies": {
    "css-tree": "3.1.0",
    "@finance-tracker/shared": "*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.0",
    "parse5": "7.3.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.5"
  }
}
